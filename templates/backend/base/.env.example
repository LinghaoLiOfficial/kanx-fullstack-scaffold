APP_NAME={{PROJECT_NAME}}
APP_SLUG={{PROJECT_SLUG}}
APP_VERSION=0.1.0
APP_ENV=local
APP_PROFILE={{PROFILE}}
LOG_LEVEL=INFO
LOG_FILE=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_REDACT_FIELDS=password,token,secret,api_key,authorization,cookie
OTEL_ENABLED=false
OTEL_SERVICE_NAME={{PROJECT_SLUG}}
OTEL_EXPORTER_OTLP_ENDPOINT=
OBSERVABILITY_EXPORTER_URL=
OBSERVABILITY_EXPORTER_KIND=otlp
DATABASE_URL=postgresql+asyncpg://foundation:foundation@localhost:55432/{{DATABASE_NAME}}
DATABASE_USER=foundation
DATABASE_PASSWORD=foundation
DATABASE_NAME={{DATABASE_NAME}}
DATABASE_HOST_PORT=55432
COMPOSE_PROJECT_NAME={{PROJECT_SLUG}}
TEMPORAL_HOST=localhost:7233
TEMPORAL_UI_URL=http://localhost:8233
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE={{TEMPORAL_NAMESPACE}}
TEMPORAL_TASK_QUEUE={{TEMPORAL_TASK_QUEUE}}
# Local dev worker processes sharing one task queue; Activity limit is per process.
TEMPORAL_WORKER_PROCESSES=1
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL_AUTO_REGISTER_NAMESPACE=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
HEALTH_TIMEOUT_SECONDS=3
JOBS_POLL_INTERVAL_SECONDS=1
JOBS_BATCH_SIZE=20
JOBS_GLOBAL_CONCURRENCY=100
JOBS_TENANT_CONCURRENCY=10
JOBS_LEASE_SECONDS=60
JOBS_MAX_BATCH_SIZE=1000
JOBS_WEBHOOK_ENCRYPTION_KEY=
AUTH_JWT_SECRET=development-only-change-me-32-bytes
AUTH_JWT_ISSUER={{PROJECT_SLUG}}
AUTH_JWT_AUDIENCE={{PROJECT_SLUG}}-api
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SECURE_COOKIES=false
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_HOST_PORT=1025
EMAIL_UI_PORT=8025
EMAIL_FROM_ADDRESS=no-reply@example.local
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=foundation
STORAGE_SECRET_KEY=foundation-secret
STORAGE_BUCKET={{PROJECT_SLUG}}
STORAGE_HOST_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_REGION=us-east-1
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_MULTIPART_THRESHOLD=33554432
STORAGE_MULTIPART_PART_SIZE=16777216
STORAGE_MULTIPART_EXPIRY_HOURS=24
STORAGE_MEDIA_PROBE_TIMEOUT_SECONDS=15
STORAGE_MAX_IMAGE_PIXELS=100000000
STORAGE_CDN_BASE_URL=
STORAGE_CDN_SIGNING_SECRET=
STORAGE_EVENT_WEBHOOK_SECRET=
STORAGE_EVENT_QUEUE_URL=
AI_BASE_URL=https://api.relayrouter.ai/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_CONNECT_TIMEOUT_SECONDS=20
AI_READ_TIMEOUT_SECONDS=300
AI_TEMPERATURE=0
AI_MAX_TOKENS=2048
AI_TASK_CONFIGS={}
AI_WORKFLOW_MODE=mock
